2024-06-24 19:21:26,345 - DEBUG - handle_msg[02b3d1258de54932a6e3d8b7c6524aad]({'header': {'date': datetime.datetime(2024, 6, 25, 0, 21, 26, 343000, tzinfo=tzutc()), 'msg_id': 'f74c5a09-6204-491c-9c0d-26d10ee0f453', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': 'f74c5a09-6204-491c-9c0d-26d10ee0f453', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '02b3d1258de54932a6e3d8b7c6524aad', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Alice Johnson <alice.johnson@example.com>\nSent:    Wednesday, May 28, 2024 11:00 AM\nTo:      Finance Department <finance@businessdomain.com>\nCc:      Customer Service <service@businessdomain.com>\nSubject: Query on Payment Terms and Discount Application Time\n\nHi,\n\nI recently placed an order with the expectation of a 15% first-time user discount. I completed the transaction but did not see the discount applied. Can you confirm the payment terms and how long it typically takes for such discounts to reflect on an invoice?\n\nThank you,\nAlice</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Alice Johnson <alice.johnson@example.com>\nSent:    Wednesday, May 28, 2024 11:00 AM\nTo:      Finance Department <finance@businessdomain.com>\nCc:      Customer Service <service@businessdomain.com>\nSubject: Query on Payment Terms and Discount Application Time\n\nHi,\n\nI recently placed an order with the expectation of a 15% first-time user discount. I completed the transaction but did not see the discount applied. Can you confirm the payment terms and how long it typically takes for such discounts to reflect on an invoice?\n\nThank you,\nAlice</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from alice johnson sent wednesday may am to finance department finance cc customer service service subject query payment terms discount application time hi recently placed order expectation user discount completed transaction see discount applied can confirm payment term long typically take discount reflect invoice thank alice</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
