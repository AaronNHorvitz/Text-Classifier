2024-06-24 18:34:48,632 - DEBUG - handle_msg[67de5799cfff47f79f32b49c38889cc1]({'header': {'date': datetime.datetime(2024, 6, 24, 23, 34, 48, 630000, tzinfo=tzutc()), 'msg_id': 'be76081f-4efa-4737-8c55-f130b38488b7', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': 'be76081f-4efa-4737-8c55-f130b38488b7', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '67de5799cfff47f79f32b49c38889cc1', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Marcus Li <marcus.li@onlineretailer.com>\nSent:    Friday, June 6, 2024 12:30 PM\nTo:      Feedback Team <feedback@onlineretailer.com>\nBcc:     Management Team <management@onlineretailer.com>\nSubject: Customer Feedback Request for Q2 2024 Improvements\n\nHello Team,\n\nAs part of our commitment to continuously improve our service, we are reaching out to a select group of customers to gather feedback on their recent experiences with our online platform.\n\nThe feedback form is attached, and we encourage honesty as it will help us serve you better. Please complete and return it by June 20, 2024.\n\nThank you,\nMarcus Li\nCustomer Relations Manager\n\n--- On Fri, 6/6/24, Customer <customer@email.com> wrote:\n\nFrom: Customer <customer@email.com>\nSubject: Re: Thank You for Your Purchase!\nTo: Marcus Li <marcus.li@onlineretailer.com>\nSent: Thursday, June 5, 2024 3:45 PM\n\nThank you for the prompt delivery. I noticed some issues with the user interface that could be improved. I\'m glad to provide detailed feedback if needed.\n\nBest,\n[Customer Name]\n</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Marcus Li <marcus.li@onlineretailer.com>\nSent:    Friday, June 6, 2024 12:30 PM\nTo:      Feedback Team <feedback@onlineretailer.com>\nBcc:     Management Team <management@onlineretailer.com>\nSubject: Customer Feedback Request for Q2 2024 Improvements\n\nHello Team,\n\nAs part of our commitment to continuously improve our service, we are reaching out to a select group of customers to gather feedback on their recent experiences with our online platform.\n\nThe feedback form is attached, and we encourage honesty as it will help us serve you better. Please complete and return it by June 20, 2024.\n\nThank you,\nMarcus Li\nCustomer Relations Manager\n\n--- On Fri, 6/6/24, Customer <customer@email.com> wrote:\n\nFrom: Customer <customer@email.com>\nSubject: Re: Thank You for Your Purchase!\nTo: Marcus Li <marcus.li@onlineretailer.com>\nSent: Thursday, June 5, 2024 3:45 PM\n\nThank you for the prompt delivery. I noticed some issues with the user interface that could be improved. I\'m glad to provide detailed feedback if needed.\n\nBest,\n[Customer Name]\n</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from marcus li sent friday june pm to feedback team feedback bcc management team management subject customer feedback request improvements hello team as part commitment continuously improve service reaching select group customer gather feedback recent experience online platform the feedback form attached encourage honesty help u serve better please complete return june thank marcus li customer relations manager on fri customer customer wrote from customer customer subject re thank you your purchase to marcus li sent thursday june pm thank prompt delivery noticed issue user interface could improved glad provide detailed feedback needed best customer name</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
