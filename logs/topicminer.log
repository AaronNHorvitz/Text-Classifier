2024-06-24 21:46:49,209 - DEBUG - handle_msg[98c2bcdb198c4833bce15e5311632a8f]({'header': {'date': datetime.datetime(2024, 6, 25, 2, 46, 49, 207000, tzinfo=tzutc()), 'msg_id': 'ad054e3a-9e5a-4511-b256-70c12b9f8b1a', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': 'ad054e3a-9e5a-4511-b256-70c12b9f8b1a', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '98c2bcdb198c4833bce15e5311632a8f', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Emily Turner <emily.turner@businessdomain.com>\nSent:    Monday, June 2, 2024 8:47 AM\nTo:      IT Support <itsupport@businessdomain.com>\nCc:      John Doe <john.doe@businessdomain.com>; Customer Relations <cust.relations@businessdomain.com>\nSubject: Urgent: Repeated Login Failures Reported by Multiple Users\n\nHi Team,\n\nWe have received multiple reports this morning from users experiencing login failures despite correct credentials being entered. This issue seems to be escalating and affecting more of our customers.\n\nCan we have an immediate check on the server logs and possibly escalate this to the network team if necessary? We need a swift resolution to avoid further customer dissatisfaction.\n\nThanks,\nEmily</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Emily Turner <emily.turner@businessdomain.com>\nSent:    Monday, June 2, 2024 8:47 AM\nTo:      IT Support <itsupport@businessdomain.com>\nCc:      John Doe <john.doe@businessdomain.com>; Customer Relations <cust.relations@businessdomain.com>\nSubject: Urgent: Repeated Login Failures Reported by Multiple Users\n\nHi Team,\n\nWe have received multiple reports this morning from users experiencing login failures despite correct credentials being entered. This issue seems to be escalating and affecting more of our customers.\n\nCan we have an immediate check on the server logs and possibly escalate this to the network team if necessary? We need a swift resolution to avoid further customer dissatisfaction.\n\nThanks,\nEmily</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from emily turner sent monday june am to it support itsupport cc john doe customer relations subject urgent repeated login failures reported multiple users hi team we received multiple report morning user experiencing login failure despite correct credential entered this issue seems escalating affecting customer can immediate check server log possibly escalate network team necessary we need swift resolution avoid customer dissatisfaction thanks emily</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
