2024-06-24 21:46:48,118 - DEBUG - handle_msg[98c2bcdb198c4833bce15e5311632a8f]({'header': {'date': datetime.datetime(2024, 6, 25, 2, 46, 48, 108000, tzinfo=tzutc()), 'msg_id': '3a087fc2-9f37-48f9-8ccf-00f85445862b', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': '3a087fc2-9f37-48f9-8ccf-00f85445862b', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '98c2bcdb198c4833bce15e5311632a8f', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Alice Johnson <alice.johnson@example.com>\nSent:    Wednesday, May 28, 2024 11:00 AM\nTo:      Finance Department <finance@businessdomain.com>\nCc:      Customer Service <service@businessdomain.com>\nSubject: Query on Payment Terms and Discount Application Time\n\nHi,\n\nI recently placed an order with the expectation of a 15% first-time user discount. I completed the transaction but did not see the discount applied. Can you confirm the payment terms and how long it typically takes for such discounts to reflect on an invoice?\n\nThank you,\nAlice</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Alice Johnson <alice.johnson@example.com>\nSent:    Wednesday, May 28, 2024 11:00 AM\nTo:      Finance Department <finance@businessdomain.com>\nCc:      Customer Service <service@businessdomain.com>\nSubject: Query on Payment Terms and Discount Application Time\n\nHi,\n\nI recently placed an order with the expectation of a 15% first-time user discount. I completed the transaction but did not see the discount applied. Can you confirm the payment terms and how long it typically takes for such discounts to reflect on an invoice?\n\nThank you,\nAlice</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from alice johnson sent wednesday may am to finance department finance cc customer service service subject query payment terms discount application time hi recently placed order expectation user discount completed transaction see discount applied can confirm payment term long typically take discount reflect invoice thank alice</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
2024-06-24 21:46:48,645 - DEBUG - handle_msg[cdd4dd34505e46f2a0e6b0104a431cfa]({'header': {'date': datetime.datetime(2024, 6, 25, 2, 46, 48, 640000, tzinfo=tzutc()), 'msg_id': '65bfb554-4c1b-4d5b-84f6-9477f47c32cc', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': '65bfb554-4c1b-4d5b-84f6-9477f47c32cc', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': 'cdd4dd34505e46f2a0e6b0104a431cfa', 'data': {'method': 'custom', 'content': {'event': 'click'}}}, 'buffers': []})
2024-06-24 21:46:48,698 - DEBUG - handle_msg[98c2bcdb198c4833bce15e5311632a8f]({'header': {'date': datetime.datetime(2024, 6, 25, 2, 46, 48, 697000, tzinfo=tzutc()), 'msg_id': '1c080b1c-5d30-4b49-91d3-b5b972b56e5e', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': '1c080b1c-5d30-4b49-91d3-b5b972b56e5e', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '98c2bcdb198c4833bce15e5311632a8f', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Robert Lee <robert.lee@example.com>\nSent:    Thursday, May 29, 2024 1:45 PM\nTo:      Customer Service <service@businessdomain.com>\nSubject: Re: Issue with Last Service\n\nHello,\n\nI am following up on my last service request. The issue was not resolved satisfactorily, and I would like to know the next steps for escalation. Please advise.\n\nRegards,\nRobert</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Robert Lee <robert.lee@example.com>\nSent:    Thursday, May 29, 2024 1:45 PM\nTo:      Customer Service <service@businessdomain.com>\nSubject: Re: Issue with Last Service\n\nHello,\n\nI am following up on my last service request. The issue was not resolved satisfactorily, and I would like to know the next steps for escalation. Please advise.\n\nRegards,\nRobert</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from robert lee sent thursday may pm to customer service service subject re issue last service hello following last service request the issue resolved satisfactorily would like know next step escalation please advise regards robert</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
