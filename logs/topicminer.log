2024-06-24 18:34:46,710 - DEBUG - handle_msg[67de5799cfff47f79f32b49c38889cc1]({'header': {'date': datetime.datetime(2024, 6, 24, 23, 34, 46, 708000, tzinfo=tzutc()), 'msg_id': '8158ddf3-7d72-4e72-be97-51f8af604c8c', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': '8158ddf3-7d72-4e72-be97-51f8af604c8c', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '67de5799cfff47f79f32b49c38889cc1', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    Jenna Clarkson <jenna.clarkson@widgetsinc.com>\nSent:    Wednesday, June 4, 2024 9:22 AM\nTo:      Accounts Payable <ap@vendorservices.com>\nSubject: Inquiry About Extended Payment Terms on Invoice #4567\nAttachments: Invoice_4567.pdf\n\nDear Accounts Team,\n\nI am writing to inquire about the possibility of extending the payment terms for the attached invoice #4567 due to unforeseen circumstances in our cash flow this quarter.\n\nCould you please review our request and let us know if it is possible to extend the terms to 60 days for this particular invoice?\n\nBest regards,\nJenna Clarkson\nCFO, Widgets Inc.\n\n--- On Wed, 6/4/24, Accounts Payable <ap@vendorservices.com> wrote:\n\nFrom: Accounts Payable <ap@vendorservices.com>\nSubject: Re: Your Invoice #4567 Due Soon\nTo: Jenna Clarkson <jenna.clarkson@widgetsinc.com>\nSent: Monday, June 2, 2024 11:48 AM\n\nDear Jenna,\n\nThis is a reminder that your payment for Invoice #4567 is due on June 15, 2024. Please ensure that payment is made by the due date to avoid any late fees.\n\nThank you,\nAccounts Payable</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    Jenna Clarkson <jenna.clarkson@widgetsinc.com>\nSent:    Wednesday, June 4, 2024 9:22 AM\nTo:      Accounts Payable <ap@vendorservices.com>\nSubject: Inquiry About Extended Payment Terms on Invoice #4567\nAttachments: Invoice_4567.pdf\n\nDear Accounts Team,\n\nI am writing to inquire about the possibility of extending the payment terms for the attached invoice #4567 due to unforeseen circumstances in our cash flow this quarter.\n\nCould you please review our request and let us know if it is possible to extend the terms to 60 days for this particular invoice?\n\nBest regards,\nJenna Clarkson\nCFO, Widgets Inc.\n\n--- On Wed, 6/4/24, Accounts Payable <ap@vendorservices.com> wrote:\n\nFrom: Accounts Payable <ap@vendorservices.com>\nSubject: Re: Your Invoice #4567 Due Soon\nTo: Jenna Clarkson <jenna.clarkson@widgetsinc.com>\nSent: Monday, June 2, 2024 11:48 AM\n\nDear Jenna,\n\nThis is a reminder that your payment for Invoice #4567 is due on June 15, 2024. Please ensure that payment is made by the due date to avoid any late fees.\n\nThank you,\nAccounts Payable</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from jenna clarkson sent wednesday june am to accounts payable ap subject inquiry about extended payment terms invoice attachments dear accounts team writing inquire possibility extending payment term attached invoice due unforeseen circumstance cash flow quarter could please review request let u know possible extend term day particular invoice best regard jenna clarkson cfo widgets on wed accounts payable ap wrote from accounts payable ap subject re your invoice due soon to jenna clarkson sent monday june am dear jenna this reminder payment invoice due june please ensure payment made due date avoid late fee thank accounts payable</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
