2024-06-24 18:34:47,869 - DEBUG - handle_msg[67de5799cfff47f79f32b49c38889cc1]({'header': {'date': datetime.datetime(2024, 6, 24, 23, 34, 47, 866000, tzinfo=tzutc()), 'msg_id': '6ba8a9a0-1cd8-4831-9187-35119b0823b9', 'msg_type': 'comm_msg', 'session': '6c05d9bb-a5ac-4cc6-a92b-e50f3548d7cb', 'username': 'e3e87b61-2680-4d1e-8b7a-d563ba12dd76', 'version': '5.2'}, 'msg_id': '6ba8a9a0-1cd8-4831-9187-35119b0823b9', 'msg_type': 'comm_msg', 'parent_header': {}, 'metadata': {}, 'content': {'comm_id': '67de5799cfff47f79f32b49c38889cc1', 'data': {'method': 'update', 'state': {'outputs': [{'output_type': 'display_data', 'data': {'text/plain': '<IPython.core.display.HTML object>', 'text/html': '\n                    <style>\n                        .email-view {\n                            width: 32%;\n                            overflow-wrap: break-word;\n                            white-space: pre-wrap;\n                            text-align: left;\n                            padding: 10px;\n                        }\n                        table {\n                            width: 100%;\n                            table-layout: fixed;\n                            border-collapse: collapse;\n                        }\n                        td {\n                            vertical-align: top;\n                            border: 1px solid #ccc;\n                        }\n                        mark {\n                            background-color: yellow;\n                            font-weight: bold;\n                        }\n                    </style>\n                    <table>\n                        <tr>\n                            <td class="email-view"><b>Original Email (with highlights):</b><br>From:    IT Department <it.notifications@techfirm.com>\nSent:    Thursday, June 5, 2024 8:00 AM\nTo:      All Employees <allemployees@techfirm.com>\nSubject: Scheduled Upgrade to CRM Software on June 10, 2024\n\nDear Team,\n\nPlease be informed that there will be a scheduled upgrade to our CRM software system next week on June 10, 2024. The system will be unavailable from 1 AM to 4 AM during the upgrade.\n\nEnsure all your work is saved and logged out of the system before the upgrade begins to prevent any data loss.\n\nThank you for your cooperation.\n\nBest,\nIT Department\n\n--- On Thu, 6/5/24, Jane Doe <jane.doe@techfirm.com> replied:\n\nFrom: Jane Doe <jane.doe@techfirm.com>\nSubject: Re: Scheduled Upgrade to CRM Software on June 10, 2024\nTo: IT Department <it.notifications@techfirm.com>\nSent: Thursday, June 5, 2024 8:15 AM\n\nThank you for the update. Will there be any training provided on the new features of the CRM post-upgrade?\n\nRegards,\nJane\n</td>\n                            <td class="email-view"><b>Email Without Unwanted Texts:</b><br>From:    IT Department <it.notifications@techfirm.com>\nSent:    Thursday, June 5, 2024 8:00 AM\nTo:      All Employees <allemployees@techfirm.com>\nSubject: Scheduled Upgrade to CRM Software on June 10, 2024\n\nDear Team,\n\nPlease be informed that there will be a scheduled upgrade to our CRM software system next week on June 10, 2024. The system will be unavailable from 1 AM to 4 AM during the upgrade.\n\nEnsure all your work is saved and logged out of the system before the upgrade begins to prevent any data loss.\n\nThank you for your cooperation.\n\nBest,\nIT Department\n\n--- On Thu, 6/5/24, Jane Doe <jane.doe@techfirm.com> replied:\n\nFrom: Jane Doe <jane.doe@techfirm.com>\nSubject: Re: Scheduled Upgrade to CRM Software on June 10, 2024\nTo: IT Department <it.notifications@techfirm.com>\nSent: Thursday, June 5, 2024 8:15 AM\n\nThank you for the update. Will there be any training provided on the new features of the CRM post-upgrade?\n\nRegards,\nJane\n</td>\n                            <td class="email-view"><b>Processed Email:</b><br>from it department sent thursday june am to all employees allemployees subject scheduled upgrade crm software june dear team please informed scheduled upgrade crm software system next week june the system unavailable am am upgrade ensure work saved logged system upgrade begin prevent data loss thank cooperation best it department on thu jane doe replied from jane doe subject re scheduled upgrade crm software june to it department sent thursday june am thank update will training provided new feature crm regards jane</td>\n                        </tr>\n                    </table>\n                    '}, 'metadata': {}}]}, 'buffer_paths': []}}, 'buffers': []})
